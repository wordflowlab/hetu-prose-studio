{
  "manifest_version": 1,
  "host_api": "1",
  "id": "org.wordflowlab.prose-studio",
  "version": "0.1.0",
  "display": {
    "zh-CN": "文风工坊",
    "en": "Prose Studio"
  },
  "description": {
    "zh-CN": "围绕固定作品，由Agent维护、作者审阅的文风工坊。",
    "en": "Evidence-based Prose Studio for your creative work."
  },
  "license": "Apache-2.0",
  "dependencies": [],
  "work_kinds": [
    "novel"
  ],
  "runtime": {
    "entry": "backend.mjs"
  },
  "contributions": {
    "views": [
      {
        "id": "main",
        "title": "文风工坊",
        "entry": "index.html",
        "object_kinds": [
          "prose_studio"
        ],
        "navigation": "integrated"
      }
    ],
    "data": [
      {
        "kind": "prose_studio",
        "schema_version": "1.0.0",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "format_version": {
              "const": 1
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  },
                  "scope": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "work",
                          "character",
                          "chapter"
                        ]
                      },
                      "target": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 100
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "kind",
                      "target"
                    ]
                  },
                  "origin": {
                    "type": "string",
                    "enum": [
                      "author_statement",
                      "agent_inference"
                    ]
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "proposed",
                      "active",
                      "disabled"
                    ]
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "source_index": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 99
                        },
                        "byte_start": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 100000000
                        },
                        "byte_end": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 100000000
                        },
                        "quote": {
                          "type": "string",
                          "minLength": 0,
                          "maxLength": 16000
                        }
                      },
                      "required": [
                        "source_index",
                        "byte_start",
                        "byte_end",
                        "quote"
                      ]
                    },
                    "maxItems": 100
                  },
                  "conflict_with": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "maxItems": 100
                  }
                },
                "required": [
                  "id",
                  "text",
                  "scope",
                  "origin",
                  "status",
                  "evidence",
                  "conflict_with"
                ]
              },
              "maxItems": 200
            },
            "comparisons": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "goal": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  },
                  "candidates": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        },
                        "source_index": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 99
                        },
                        "strategy": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 4000
                        },
                        "tradeoffs": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 2000
                          },
                          "maxItems": 20
                        }
                      },
                      "required": [
                        "id",
                        "source_index",
                        "strategy",
                        "tradeoffs"
                      ]
                    },
                    "maxItems": 20
                  }
                },
                "required": [
                  "id",
                  "title",
                  "goal",
                  "candidates"
                ]
              },
              "maxItems": 200
            },
            "refinements": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "baseline_source_index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 99
                  },
                  "candidate_source_index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 99
                  },
                  "patches": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "byte_start": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 100000000
                        },
                        "byte_end": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 100000000
                        },
                        "replacement_bytes": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 1000000
                        },
                        "replacement_sha256": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        }
                      },
                      "required": [
                        "byte_start",
                        "byte_end",
                        "replacement_bytes",
                        "replacement_sha256"
                      ]
                    },
                    "maxItems": 100
                  }
                },
                "required": [
                  "id",
                  "title",
                  "baseline_source_index",
                  "candidate_source_index",
                  "patches"
                ]
              },
              "maxItems": 200
            }
          },
          "required": [
            "format_version",
            "title",
            "rules",
            "comparisons",
            "refinements"
          ]
        }
